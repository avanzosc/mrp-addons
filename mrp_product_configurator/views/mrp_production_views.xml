<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_production_form_view" model="ir.ui.view">
    <field name="name">mrp.production.form.product.configurator</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="arch" type="xml">
      <field name="product_id" default_focus="1" position="attributes">
        <attribute name="widget">mrp_product_many2one</attribute>
      </field>
      <field name="product_id" default_focus="1" position="after">
        <field name="product_variant_attributes" invisible="1" />
        <field name="is_configurable_product" invisible="1" />
        <field name="configurator_pricelist_id" invisible="1" />
        <field name="configurator_currency_id" invisible="1" />
      </field>
    </field>
  </record>
</odoo>
