<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="purchase_order_form_view_external_subcontract" model="ir.ui.view">
    <field name="name">purchase.order.form.external.subcontract</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_ref']" position="after">
        <field name="subcon_purchase" />
        <field name="workorder_id" invisible="not subcon_purchase" />
      </xpath>
    </field>
  </record>
</odoo>
