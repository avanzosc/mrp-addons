<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_template_form_view_subcontracting_charges" model="ir.ui.view">
    <field name="name">product.template.form.subcontracting.charges</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//notebook/page[@name='purchase']" position="after">
        <page
          string="Additional Charges"
          name="subcontracting_charges"
          invisible="type != 'service' or not subcon_operations"
        >
          <field name="subcontracting_charge_ids">
            <list editable="bottom">
              <field name="product_id" />
              <field name="quantity_calculation" />
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
