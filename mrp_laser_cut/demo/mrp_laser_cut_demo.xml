<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="workcenter_fiber_laser" model="mrp.workcenter">
    <field name="name">Fiber Laser Cutter</field>
    <field name="code">LASER-01</field>
    <field name="is_laser" eval="True" />
    <field name="time_start">5</field>
    <field name="time_stop">5</field>
  </record>

  <record id="workcenter_press_brake" model="mrp.workcenter">
    <field name="name">Press Brake</field>
    <field name="code">BRAKE-01</field>
    <field name="time_start">3</field>
    <field name="time_stop">3</field>
  </record>

  <record id="product_laser_run" model="product.product">
    <field name="name">Laser Cutting Run</field>
    <field name="default_code">LASER-RUN</field>
    <field
      name="image_1920"
      type="base64"
      file="mrp_laser_cut/static/src/img/LASER-RUN.jpg"
    />
    <field name="type">consu</field>
    <field name="is_storable" eval="False" />
    <field name="uom_id" ref="uom.product_uom_unit" />
    <field name="uom_po_id" ref="uom.product_uom_unit" />
    <field name="purchase_ok" eval="False" />
    <field name="sale_ok" eval="False" />
  </record>

  <record id="bom_laser_run" model="mrp.bom">
    <field name="product_tmpl_id" ref="product_laser_run_product_template" />
    <field name="product_qty">1</field>
    <field name="product_uom_id" ref="uom.product_uom_unit" />
    <field name="type">normal</field>
    <field name="code">LASER-RUN</field>
  </record>

  <record id="operation_laser_run" model="mrp.routing.workcenter">
    <field name="name">Laser cutting</field>
    <field name="bom_id" ref="bom_laser_run" />
    <field name="workcenter_id" ref="workcenter_fiber_laser" />
    <field name="time_cycle_manual">1</field>
  </record>

  <function
    model="res.company"
    name="write"
    eval="[[ref('base.main_company')], {'laser_bom_id': ref('bom_laser_run')}]"
  />

