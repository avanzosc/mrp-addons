<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//block[@name='process_operations_setting_container']"
        position="after"
      >
        <block title="Laser Cutting" name="laser_cutting_setting_container">
          <setting
            id="laser_bom"
            string="Bill of Materials"
            help="Bill of Materials proposed by default on new laser cutting orders; its product is the generic item manufactured by the generated manufacturing orders"
          >
            <field name="laser_bom_id" />
          </setting>
          <setting
            id="laser_offcut_product"
            string="Offcut Product"
            help="Generic, consumable product proposed by default when a laser cutting order is flagged to use offcut (remnant) material"
          >
            <field name="laser_offcut_product_id" />
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
