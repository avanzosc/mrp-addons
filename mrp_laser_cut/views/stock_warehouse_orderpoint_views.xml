<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_warehouse_orderpoint_tree_editable" model="ir.ui.view">
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
    <field name="mode">primary</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <field name="qty_to_order" position="attributes">
        <attribute name="sum">Total to Order</attribute>
      </field>
      <field name="product_id" position="attributes">
        <attribute name="domain">[('is_laser_cut', '=', True)]</attribute>
        <attribute
          name="context"
        >{'default_is_storable': True, 'default_is_laser_cut': True}</attribute>
      </field>
      <field name="product_uom_name" position="after">
        <field name="laser_material_id" />
        <field name="unit_consumption" sum="Consumption" />
        <field name="material_unit_weight" />
      </field>
      <xpath expr="//list" position="inside">
        <header>
          <button
            name="action_create_laser_order"
            type="object"
            string="Create Laser Cutting Order"
            class="oe_highlight"
          />
        </header>
      </xpath>
    </field>
  </record>

  <record id="stock_reorder_report_search" model="ir.ui.view">
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.stock_reorder_report_search" />
    <field name="mode">primary</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="laser_material_id" />
      </field>
      <xpath expr="//search" position="inside">
        <group expand="0" string="Group By">
          <filter
            string="Raw Material"
            name="group_laser_material"
            context="{'group_by': 'laser_material_id'}"
          />
        </group>
      </xpath>
    </field>
  </record>

  <record id="stock_warehouse_orderpoint_laser_action" model="ir.actions.act_window">
    <field name="name">Laser Cutting Replenishment</field>
    <field name="res_model">stock.warehouse.orderpoint</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_warehouse_orderpoint_tree_editable" />
    <field name="search_view_id" ref="stock_reorder_report_search" />
    <field name="domain">[('product_id.is_laser_cut', '=', True)]</field>
    <field name="context">{'laser_replenishment': True}</field>
  </record>

  <record id="stock_warehouse_orderpoint_laser_server_action" model="ir.actions.server">
    <field name="name">Laser Cutting Replenishment</field>
    <field name="model_id" ref="stock.model_stock_warehouse_orderpoint" />
    <field name="state">code</field>
    <field name="code">action = model.action_open_laser_orderpoints()</field>
  </record>

  <menuitem
    id="menu_laser_orderpoint_replenish"
    name="Laser Cutting Replenishment"
    action="stock_warehouse_orderpoint_laser_server_action"
    parent="stock.menu_stock_procurement"
    groups="stock.group_stock_manager"
    sequence="20"
  />
</odoo>
