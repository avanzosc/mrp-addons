<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_subcontracting_charge_form" model="ir.ui.view">
        <field name="name">product.template.subcontracting.charge.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='purchase']" position="after">
                <page
          string="Additional charges"
          attrs="{'invisible': ['|', ('detailed_type', '!=', 'service'), ('subcon_operations', '=', False)]}"
        >
                    <field name="subcontracting_charge_ids">
                        <tree editable="bottom">
                            <field name="product_id" />
                            <field name="quantity_calculation" />
                        </tree>
                        <form string="Additional charge">
                            <group>
                                <field name="product_id" />
                                <field name="quantity_calculation" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
