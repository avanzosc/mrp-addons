<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_production_workorder_form_view_inherit" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='move_raw_ids']/tree//field[@name='product_virtual_available']"
        position="after"
      >
                <button
          name="%(stock_quant_manual_assign.assign_manual_quants_action)d"
          type="action"
          icon="fa-tags"
          title="Manual Quants"
          options='{"warn": true}'
          attrs="{'invisible':[('state','not in',('confirmed','assigned','partially_available'))]}"
        />
            </xpath>
        </field>
    </record>

</odoo>
