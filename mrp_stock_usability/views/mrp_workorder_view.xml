<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_workorder_view_form" model="ir.ui.view">
    <field name="model">mrp.workorder</field>
    <field name="priority" eval="99" />
    <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
    <field name="arch" type="xml">
      <sheet position="inside">
        <field name="show_final_lots" invisible="1" />
        <field name="use_create_components_lots" invisible="1" />
      </sheet>
      <xpath expr="//page[@name='components']" position="replace">
        <page
          string="Components"
          name="components"
          invisible="not move_raw_ids or not date_start"
        >
          <field
            name="move_raw_ids"
            readonly="production_state == 'cancel' or (production_state == 'done' and working_state == 'blocked')"
          >
            <list default_order="is_done,sequence" editable="bottom" create="0">
              <field
                name="product_id"
                readonly="move_lines_count &gt; 0 or state == 'cancel' or (state != 'draft' and not additional)"
              />

              <field name="move_line_ids" column_invisible="True">
                <list>
                  <field name="lot_id" column_invisible="True" />
                  <field name="owner_id" column_invisible="True" />
                  <field name="package_id" column_invisible="True" />
                  <field name="result_package_id" column_invisible="True" />
                  <field name="location_id" column_invisible="True" />
                  <field name="location_dest_id" column_invisible="True" />
                  <field name="quantity" column_invisible="True" />
                  <field name="product_id" column_invisible="True" />
                  <field name="product_uom_id" column_invisible="True" />
                  <field name="state" column_invisible="True" />
                  <field name="move_id" column_invisible="True" />
                  <field name="id" column_invisible="True" />
                </list>
              </field>

              <field name="company_id" column_invisible="True" />
              <field name="product_uom_category_id" column_invisible="True" />
              <field name="name" column_invisible="True" />
              <field name="allowed_operation_ids" column_invisible="True" />
              <field name="unit_factor" column_invisible="True" />
              <field name="date_deadline" column_invisible="True" />
              <field name="date" column_invisible="True" />
              <field name="additional" column_invisible="True" />
              <field name="picking_type_id" column_invisible="True" />
              <field name="has_tracking" column_invisible="True" />
              <field name="operation_id" column_invisible="True" />
              <field name="is_done" column_invisible="True" />
              <field name="bom_line_id" column_invisible="True" />
              <field name="sequence" column_invisible="True" />
              <field name="location_id" column_invisible="True" />
              <field name="warehouse_id" column_invisible="True" />
              <field name="is_locked" column_invisible="True" />
              <field name="move_lines_count" column_invisible="True" />
              <field name="location_dest_id" column_invisible="True" />
              <field name="state" column_invisible="True" force_save="1" />
              <field name="should_consume_qty" column_invisible="True" />
              <field
                name="product_uom_qty"
                widget="mrp_should_consume"
                string="To Consume"
                readonly="parent.production_state != 'draft' and (parent.production_state not in ('confirmed', 'progress', 'to_close') or parent.working_state == 'blocked')"
                width="1"
              />
              <field name="product_qty" column_invisible="True" readonly="1" />
              <field name="forecast_expected_date" column_invisible="True" />
              <field
                name="forecast_availability"
                string="Reserved"
                column_invisible="parent.production_state in ['draft', 'done']"
                widget="forecast_widget"
              />
              <field name="is_quantity_done_editable" column_invisible="True" />
              <field
                name="quantity"
                string="Consumed"
                decoration-success="not is_done and (quantity - should_consume_qty == 0)"
                decoration-warning="not is_done and (quantity - should_consume_qty &gt; 0.0001)"
                column_invisible="parent.state == 'draft'"
                readonly="show_details_visible"
              />
              <field
                name="product_uom"
                readonly="state != 'draft' and id"
                options="{'no_open': True, 'no_create': True}"
                groups="uom.group_uom"
              />
              <field name="show_details_visible" column_invisible="True" />
              <field
                name="lot_ids"
                widget="many2many_tags"
                groups="stock.group_production_lot"
                optional="hide"
                invisible="not show_details_visible or has_tracking != 'serial' or parent.production_state == 'draft'"
                readonly="not show_details_visible or has_tracking != 'serial' or parent.production_state == 'draft'"
                column_invisible="not parent.show_final_lots"
                options="{'create': [('parent.use_create_components_lots', '!=', False)]}"
                context="{'default_company_id': company_id, 'default_product_id': product_id}"
                domain="[('product_id','=',product_id)]"
              />
              <field name="group_id" column_invisible="True" />
              <button
                name="action_show_details"
                type="object"
                icon="fa-list"
                title="Show details"
                context="{'default_product_uom_qty': 0}"
                invisible="not show_details_visible"
                options="{&quot;warn&quot;: true}"
              />
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

  <record id="mrp_workorder_usability_view_form" model="ir.ui.view">
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp_workorder_view_form" />
    <field name="arch" type="xml">
      <header position="inside">
        <button
          name="action_assign"
          string="Check availability"
          type="object"
          class="oe_highlight"
          invisible="not show_check_availability"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <button
          name="button_unreserve"
          string="Unreserve"
          type="object"
          invisible="not unreserve_visible"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
      </header>
      <sheet position="inside">
        <field
          name="unreserve_visible"
          invisible="1"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <field
          name="show_check_availability"
          invisible="1"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
      </sheet>
      <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/list/button[@name='action_show_details']"
        position="after"
      >
        <field
          name="mrp_unreserve_visible"
          column_invisible="True"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <button
          name="button_assign"
          string="Check availability"
          type="object"
          class="btn btn-link"
          invisible="state not in ('confirmed', 'waiting', 'partially_available')"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <button
          name="button_unreserve"
          string="Unreserve"
          type="object"
          class="btn btn-link"
          invisible="not mrp_unreserve_visible"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
      </xpath>
    </field>
  </record>

  <record id="mrp_workorder_usability_view_tree" model="ir.ui.view">
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view" />
    <field name="arch" type="xml">
      <xpath expr="//list/widget[@name='mo_view_list_dropdown']" position="before">
        <field
          name="unreserve_visible"
          column_invisible="True"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <field
          name="show_check_availability"
          column_invisible="True"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <button
          name="action_assign"
          string="Check availability"
          type="object"
          class="btn btn-link"
          invisible="not show_check_availability"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
        <button
          name="button_unreserve"
          string="Unreserve"
          type="object"
          class="btn btn-link"
          invisible="not unreserve_visible"
          groups="mrp_stock_usability.group_mrp_stock_usability"
        />
      </xpath>
    </field>
  </record>
</odoo>
