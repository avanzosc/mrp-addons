<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_mrporder" inherit_id="mrp.report_mrporder" priority="100">
        <div t-if="o.origin" position="replace">
            <div class="col-3" t-if="o.origin">
                <strong>Source:</strong><br />
                <t t-if="o.sale_id">
                    <span t-field="o.sale_id" /><br />
                </t>
                <span t-field="o.origin" />
            </div>
            <div class="col-3" t-if="o.sale_id">
                <strong>Customer:</strong><br />
                <span t-field="o.sale_id.partner_id.name" />
            </div>
        </div>
    </template>
</odoo>
