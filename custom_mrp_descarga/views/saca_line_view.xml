<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="saca_line_form_view" model="ir.ui.view">
        <field name="model">saca.line</field>
        <field name="inherit_id" ref="custom_descarga.saca_line_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="recalc_date" readonly="1" />
            </xpath>
            <div name="button_box" position="inside">
                <button
          class="oe_stat_button"
          icon="fa-wrench"
          type="object"
          name="action_view_production"
          attrs="{'invisible': [('count_production', '=', 0)]}"
        >
                    <field
            string="Production Orders"
            name="count_production"
            widget="statinfo"
          />
                </button>
            </div>
            <xpath expr="//page[@name='classified']" position="inside">
                <group string="Deconstruction">
                    <field name="production_ids" nolabel="1">
                        <tree>
                            <field name="name" />
                            <field name="date_planned_start" widget="remaining_days" />
                            <field name="product_id" />
                            <field name="product_qty" />
                            <field name="product_uom_id" />
                            <field name="company_id" />
                            <field
                name="state"
                widget="badge"
                decoration-success="state == 'done'"
                decoration-info="state not in ('done', 'cancel')"
              />
                        </tree>
                    </field>
                </group>
            </xpath>
            <xpath expr="//field[@name='sampler_id']/../.." position="before">
                <button
          string="Update Data"
          type="object"
          name="action_compute_mo_data"
          attrs="{'invisible': [('production_ids', '=', [])]}"
        />
            </xpath>
        </field>
    </record>

    <record id="action_saca_line_update_quality" model="ir.actions.server">
        <field name="name">Update Quality Data</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="custom_saca.model_saca_line" />
        <field name="binding_model_id" ref="custom_saca.model_saca_line" />
        <field name="state">code</field>
        <field name="code">
for record in records:
    if record.production_ids:
        record.action_compute_mo_data()
        </field>
    </record>

    <record id="saca_line_tree_view" model="ir.ui.view">
        <field name="model">saca.line</field>
        <field name="inherit_id" ref="custom_saca.saca_line_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="recalc_date" optional="hide" />
            </xpath>
        </field>
    </record>

    
