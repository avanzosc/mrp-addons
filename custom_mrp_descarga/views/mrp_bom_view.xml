<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_bom_form_view" model="ir.ui.view">
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
    <field name="arch" type="xml">
      <field name="code" position="after">
        <field name="quartering" />
        <field name="no_duplicate_lines" />
        <field name="no_produce_product" />
        <field name="bring_cost_from_lots" />
        <field name="filter_only_entry_lots" />
        <field name="recalculate_cost" />
      </field>
      <page name="components" position="attributes">
        <attribute name="string">Inputs</attribute>
      </page>
      <page name="by_products" position="attributes">
        <attribute name="string">Outputs</attribute>
      </page>
      <xpath
        expr="//form/sheet/notebook/page[@name='components']/field[@name='bom_line_ids']/list/field[@name='product_qty']"
        position="after"
      >
        <field
          name="coefficient"
          optional="show"
          column_invisible="parent.is_deconstruction == False"
        />
        <field
          name="expense_kg"
          optional="show"
          column_invisible="parent.is_deconstruction == False"
        />
        <field name="currency_id" invisible="1" />
        <field
          name="cost"
          optional="show"
          widget='monetary'
          options="{'currency_field': 'currency_id'}"
          column_invisible="parent.is_deconstruction == False"
        />
      </xpath>
    </field>
  </record>

  <record id="action_quartering_bom" model="ir.actions.act_window">
    <field name="name">Material List</field>
    <field name="res_model">mrp.bom</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('quartering', '=', True)]</field>
  </record>

  <record id="action_other_bom" model="ir.actions.act_window">
    <field name="name">Material List</field>
    <field name="res_model">mrp.bom</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('quartering', '=', False)]</field>
  </record>

  <menuitem
    action="action_quartering_bom"
    name="Material List"
    id="menu_quartering_bom"
    parent="quartering_menu"
    sequence="6"
  />

  <menuitem
    action="action_other_bom"
    name="Material List"
    id="menu_other_bom"
    parent="custom_descarga.stage_clasificado_menu"
    sequence="6"
  />
</odoo>
