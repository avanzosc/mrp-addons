<odoo>
    <record id="mrp_bom_category_view_tree" model="ir.ui.view">
        <field name="model">mrp.bom.category</field>
        <field name="inherit_id" ref="mrp_bom_category.mrp_bom_category_view_tree" />
        <field name="arch" type="xml">
            <field name="sequence_id" position="after">
                <field name="is_quartering" />
            </field>
        </field>
    </record>

    <record id="mrp_bom_category_view_form" model="ir.ui.view">
        <field name="model">mrp.bom.category</field>
        <field name="inherit_id" ref="mrp_bom_category.mrp_bom_category_view_form" />
        <field name="arch" type="xml">
            <field name="sequence_id" position="after">
                <field name="is_quartering" />
            </field>
        </field>
    </record>
</odoo>
