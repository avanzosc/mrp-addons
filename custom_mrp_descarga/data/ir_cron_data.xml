<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_recalculate_cost_in_production_orders" model="ir.cron">
        <field name="name">Recalculate cost in production orders</field>
        <field name="model_id" ref="model_mrp_production" />
        <field name="state">code</field>
        <field name="code">model.ir_cron_recalculate_cost_in_production_orders()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_recalculate_lot_avergae_cost" model="ir.cron">
        <field name="name">Recalculate lot_average_cost</field>
        <field name="model_id" ref="model_sale_order_line" />
        <field name="state">code</field>
        <field name="code">model._compute_average_price()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_weekly_quality_recalculation" model="ir.cron">
        <field name="name">Weekly Quality Recalculation</field>
        <field name="model_id" ref="custom_saca.model_saca_line" />
        <field name="state">code</field>
        <field name="code">
lines = model.search([('is_canceled', '=', False)])
lines = lines.filtered(lambda l: not l.recalc_date or (l.write_date and l.write_date > l.recalc_date))
for line in lines:
    if line.production_ids:
        line.action_compute_mo_data()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2025-07-10 15:00:00</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
