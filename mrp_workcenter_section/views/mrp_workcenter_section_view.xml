<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Lista de secciones -->
  <record id="view_mrp_workcenter_section_list" model="ir.ui.view">
    <field name="name">mrp.workcenter.section.list</field>
    <field name="model">mrp.workcenter.section</field>
    <field name="arch" type="xml">
      <list string="Secciones" editable="bottom">
        <field name="name" />
      </list>
    </field>
  </record>

  <!-- Acción: abrir únicamente la lista -->
  <record id="action_mrp_workcenter_section" model="ir.actions.act_window">
    <field name="name">Secciones</field>
    <field name="res_model">mrp.workcenter.section</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_mrp_workcenter_section_list" />
  </record>

  <!-- Fabricación / Configuración / Secciones -->
  <menuitem
    id="menu_mrp_workcenter_section"
    name="Secciones"
    parent="mrp.menu_mrp_configuration"
    action="action_mrp_workcenter_section"
    sequence="25"
    groups="mrp.group_mrp_manager"
  />
</odoo>
