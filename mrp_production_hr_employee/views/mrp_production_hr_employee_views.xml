<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath
        expr="//group[@name='group_extra_info']/field[@name='user_id']"
        position="after"
      >
                <label for="employee_ids" />
                <div class="o_row">
                    <field
            name="employee_ids"
            widget="many2many_tags"
            options="{'no_create': True}"
          />
                </div>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="priority" eval="900" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned_start']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute
          name="attrs"
        >{'readonly': [('state', 'in', ['done', 'cancel'])]}</attribute>
                <attribute name="widget">datetime</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute
          name="attrs"
        >{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute
          name="attrs"
        >{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute
          name="attrs"
        >{'readonly': [('state', 'in', ['done', 'cancel'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute
          name="attrs"
        >{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_uom_category_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='message_needaction']" position="after">
                <field name="confirm_cancel" invisible="1" />
                <field name="show_lock" invisible="1" />
                <field name="is_locked" invisible="1" />
                <field name="qty_producing" invisible="1" />
                <field name="workorder_ids" invisible="1" />
                <field name="is_planned" invisible="1" />
                <field name="reserve_visible" invisible="1" />
                <field name="unreserve_visible" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field
          name="employee_ids"
          string="Employees"
          widget="many2many_tags"
          options="{'no_create': True}"
          optional="show"
        />
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_icons" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[last()]" position="after">
                <button
          name="button_mark_done"
          type="object"
          icon="fa-check"
          title="Validar"
          attrs="{'invisible': ['|', ('state', 'in', ('draft', 'cancel', 'done', 'to_close')), ('qty_producing', '=', 0)]}"
        />
                <button
          name="button_mark_done"
          type="object"
          icon="fa-check"
          title="Marcar como hecho"
          attrs="{'invisible': [
                            '&amp;',
                            '|',
                            ('state', 'not in', ('confirmed', 'progress')),
                            ('qty_producing', '!=', 0),
                            ('state', '!=', 'to_close')]}"
        />
                <button
          name="action_confirm"
          type="object"
          icon="fa-check-circle"
          title="Confirmar"
          attrs="{'invisible': [('state', '!=', 'draft')]}"
        />
                <button
          name="button_plan"
          type="object"
          icon="fa-calendar-check-o"
          title="Planificar"
          attrs="{'invisible': ['|', '|', ('state', 'not in', ('confirmed', 'progress', 'to_close')), ('workorder_ids', '=', []), ('is_planned', '=', True)]}"
        />
                <button
          name="button_unplan"
          type="object"
          icon="fa-undo"
          title="Desplanificar"
          attrs="{'invisible': [('is_planned', '=', False)]}"
        />
                <button
          name="action_assign"
          type="object"
          icon="fa-search"
          title="Comprobar disponibilidad"
          attrs="{'invisible': ['|', ('state', 'in', ('draft', 'done', 'cancel')), ('reserve_visible', '=', False)]}"
        />
                <button
          name="button_unreserve"
          type="object"
          icon="fa-trash"
          title="Anular reserva"
          attrs="{'invisible': [('unreserve_visible', '=', False)]}"
        />
                <button
          name="button_scrap"
          type="object"
          icon="fa-recycle"
          title="Desechar"
          attrs="{'invisible': [('state', 'in', ('cancel', 'draft'))]}"
        />
                <button
          name="action_toggle_is_locked"
          type="object"
          icon="fa-unlock"
          title="Desbloquear"
          groups="mrp.group_mrp_manager"
          attrs="{'invisible': ['|', ('show_lock', '=', False), ('is_locked', '=', False)]}"
        />
                <button
          name="action_toggle_is_locked"
          type="object"
          icon="fa-lock"
          title="Bloquear"
          groups="mrp.group_mrp_manager"
          attrs="{'invisible': ['|', ('show_lock', '=', False), ('is_locked', '=', True)]}"
        />
                <button
          name="action_cancel"
          type="object"
          icon="fa-times"
          title="Cancelar"
          attrs="{'invisible': ['|', '|', ('id', '=', False), ('state', 'in', ('done', 'cancel')), ('confirm_cancel', '=', True)]}"
        />
                <button
          name="action_cancel"
          type="object"
          icon="fa-times"
          title="Cancelar"
          attrs="{'invisible': ['|', '|', ('id', '=', False), ('state', 'in', ('done', 'cancel')), ('confirm_cancel', '=', False)]}"
          confirm="Algunos movimientos de producto ya se han confirmado, esta orden de producción no se puede cancelar completamente. ¿Está seguro de que quiere continuar?"
        />
                <button
          name="button_unbuild"
          type="object"
          icon="fa-rotate-left"
          title="Desmontar"
          attrs="{'invisible': [('state', '!=', 'done')]}"
        />
                <button
          name="action_open_form"
          type="object"
          icon="fa-external-link"
          title="Abrir"
        />
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_tree_editable" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" eval="False" />
        <field name="active" eval="False" />
        <field name="mode">primary</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <tree
        default_order="priority desc, date_planned_start desc"
        multi_edit="1"
        sample="1"
        editable="bottom"
      >
                <header>
                    <button name="button_plan" type="object" string="Plan" />
                    <button name="do_unreserve" type="object" string="Unreserve" />
                </header>
                <field name="priority" optional="show" widget="priority" nolabel="1" />
                <field name="message_needaction" invisible="1" />
                <field name="name" decoration-bf="1" />
                <field
          name="date_planned_start"
          readonly="0"
          optional="show"
          widget="remaining_days"
        />
                <field
          name="date_deadline"
          widget="remaining_days"
          attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"
          optional="hide"
        />
                <field name="product_id" readonly="0" optional="show" />
                <field name="product_uom_category_id" invisible="1" />
                <field
          name="product_uom_id"
          string="Unit of Measure"
          options="{'no_open':True,'no_create':True}"
          groups="uom.group_uom"
          optional="show"
        />
                <field name="lot_producing_id" optional="hide" />
                <field name="bom_id" readonly="0" optional="hide" />
                <field name="origin" optional="show" />
                <field name="user_id" optional="hide" widget="many2one_avatar_user" />
                <field name="reservation_state" optional="show" />
                <field
          name="product_qty"
          sum="Total Qty"
          string="Quantity"
          readonly="0"
          optional="show"
        />
                <field
          name="company_id"
          readonly="0"
          groups="base.group_multi_company"
          optional="show"
        />
                <field
          name="state"
          optional="show"
          widget="badge"
          decoration-success="state == 'done'"
          decoration-info="state not in ('done', 'cancel')"
        />
                <field
          name="employee_ids"
          string="Employees"
          widget="many2many_tags"
          options="{'no_create': True}"
          optional="show"
        />
                <field
          name="activity_exception_decoration"
          widget="activity_exception"
          invisible="1"
        />
                <field name="delay_alert_date" invisible="1" />
                <field
          string=" "
          name="json_popover"
          widget="stock_rescheduling_popover"
          invisible="1"
        />
            </tree>
        </field>
    </record>

    <record id="action_mrp_production_tree_editable" model="ir.actions.act_window">
        <field name="res_model">mrp.production</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mrp_production_tree_editable" />
        <field name="search_view_id" ref="mrp.view_mrp_production_filter" />
        <field
      name="context"
    >{'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}</field>
        <field name="domain">[('picking_type_id.active', '=', True)]</field>
    </record>

    <menuitem
    id="menu_mrp_production_tree_editable"
    name="Manufacturing Orders (Editable)"
    parent="mrp.menu_mrp_manufacturing"
    action="action_mrp_production_tree_editable"
    active="False"
    sequence="15"
  />

</odoo>
