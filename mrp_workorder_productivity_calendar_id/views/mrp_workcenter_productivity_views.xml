<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="oee_form_view_inherit" model="ir.ui.view">
        <field name="model">mrp.workcenter.productivity</field>
        <field name="inherit_id" ref="mrp.oee_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group/group" position="inside">
                <field name="calendar_id" options="{'no_create': True}" />
            </xpath>
        </field>
    </record>

    <record id="oee_tree_view_inherit" model="ir.ui.view">
        <field name="model">mrp.workcenter.productivity</field>
        <field name="inherit_id" ref="mrp.oee_tree_view" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="calendar_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="mrp_production_workorder_form_view_inherit_inherit" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="calendar_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
