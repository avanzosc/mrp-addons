<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_producing_id']/.." position="after">
                <label for="scrap_qty" />
                <field name="scrap_qty" nolabel="1" />
                <label for="real_quantity_produced" />
                <field name="real_quantity_produced" nolabel="1" />
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="scrap_qty" optional="show" sum="Total Scrap Qty" />
                <field
          name="real_quantity_produced"
          optional="show"
          sum="Total Real Quantity Produced"
        />
            </field>
        </field>
    </record>
</odoo>
