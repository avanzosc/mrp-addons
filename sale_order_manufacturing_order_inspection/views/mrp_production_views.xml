<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="service_product_id" string="Personalization" />
            </field>
        </field>
    </record>

    <record id="mrp_production_tree_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field
          name="service_product_id"
          string="Personalization"
          readonly="1"
          optional="show"
        />
            </field>
        </field>
    </record>

    <record id="view_mrp_production_filter" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="service_product_id" string="Personalization" />
            </field>
            <filter name="product" position="after">
                <filter
          string="Personalization"
          name="service-product"
          domain="[]"
          context="{'group_by': 'service_product_id'}"
        />
            </filter>
        </field>
    </record>

    <record id="action_from_of_create_inspection" model="ir.actions.server">
        <field name="name">Create Inspection</field>
        <field name="model_id" ref="mrp.model_mrp_production" />
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="state">code</field>
        <field name="code">
        for record in records:
            record.action_create_inspection_from_of()
        </field>
    </record>
</odoo>
