<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="qc_test_form_view" model="ir.ui.view">
        <field name="model">qc.test</field>
        <field name="inherit_id" ref="quality_control_oca.qc_test_form_view" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="qc_test_label_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="qc_test_tree_view" model="ir.ui.view">
        <field name="model">qc.test</field>
        <field name="inherit_id" ref="quality_control_oca.qc_test_tree_view" />
        <field name="arch" type="xml">
            <field name="object_id" position="after">
                <field name="qc_test_label_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
