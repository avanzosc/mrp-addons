<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="qc_test_label_tree_view" model="ir.ui.view">
        <field name="name">qc.test.label.tree.view</field>
        <field name="model">qc.test.label</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="qc_test_label_action">
        <field name="name">Quality Control Test Labels</field>
        <field name="res_model">qc.test.label</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="qc_test_label_tree_view" />
        <field name="context" />
    </record>


    <menuitem
    name="Quality Control Test Labels"
    id="menu_qc_test_label"
    parent="quality_control_oca.menu_qc_config"
    action="qc_test_label_action"
    sequence="10"
    groups="quality_control_oca.group_quality_control_manager"
  />
</odoo>
