<odoo>
    <record id="view_move_tree" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="create">true</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="groups" />
            </xpath>
            <xpath expr="//field[@name='reference']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="lot_ids" optional="show" widget="many2many_tags" />
                <field name="workorder_id" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="product_uom_category_id" invisible='1' />
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="before">
                <field
          name="quantity_done"
          readonly="1"
          attrs="{'invisible': [('workorder_id', '=', False)]}"
        />
            </xpath>
            <xpath expr="//field[@name='date']" position="before">
                <button
          name="action_show_details"
          type="object"
          icon="fa-list"
          title="Show Details"
          context="{'default_finished_move_id': id}"
        />
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_operations_finished" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="mrp.view_stock_move_operations_finished" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reserved_availability']" position="replace">
                <field
          name="product_qty"
          nolabel="1"
          attrs="{'invisible': ['|', ('state', '=', 'done'), ('from_immediate_transfer', '=', True)]}"
        />
            </xpath>
            <xpath expr="//form/group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button
            class="oe_stat_button"
            name="action_show_move_lines_packages"
            type="object"
            icon="fa-archive"
          >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Packages</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
