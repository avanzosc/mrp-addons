<odoo>
  <record id="action_finished_move_lines" model="ir.actions.act_window">
    <field name="name">Finished Move Lines</field>
    <field name="res_model">stock.move.line</field>
    <field name="view_mode">list</field>
    <field name="domain">[('move_id.production_id', '!=', False)]</field>
  </record>

  <menuitem
    id="menu_finished_move_lines"
    name="Finished Move Lines"
    parent="mrp.menu_mrp_manufacturing"
    action="action_finished_move_lines"
    sequence="50"
  />

  <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_id']" position="attributes">
        <attribute name="column_invisible">
                    context.get('show_lot_name_instead_lot_id') or parent.show_quant or parent.has_tracking == 'none' or not parent.show_lots_m2o
                </attribute>
      </xpath>
      <xpath expr="//field[@name='lot_name']" position="attributes">
        <attribute name="column_invisible">
                    not context.get('show_lot_name_instead_lot_id') and (parent.has_tracking == 'none' or not parent.show_lots_text)
                </attribute>
      </xpath>
    </field>
  </record>
</odoo>
