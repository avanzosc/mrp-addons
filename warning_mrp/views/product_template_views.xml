<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <group name="description" position="after">
                <t groups="mrp.group_mrp_manager">
                    <group string="Warning when Manufacturing this Product">
                        <field name="mrp_production_warn" string="Warning" />
                        <field
              name="mrp_production_warn_msg"
              string="Message"
              placeholder="Type a message..."
              attrs="{'required':[('mrp_production_warn','!=','no-message')],'readonly':[('mrp_production_warn','=','no-message')]}"
            />
                    </group>
                </t>
            </group>
        </field>
    </record>
</odoo>
