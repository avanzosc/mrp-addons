<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="view_workcenter_productivity_tree_ot" model="ir.ui.view">
    <field name="model">mrp.workcenter.productivity</field>
    <field name="arch" type="xml">
      <tree>
        <field name="workcenter_id" />
        <field name="calendar_id" />
        <field name="loss_id" />
        <field name="workorder_id" optional="show" />
        <field name="operator_id" optional="show" />
        <field name="production_id" optional="show" />
        <field name="product_id" optional="show" />
        <field name="procurement_group_id" optional="show" />
        <field name="date" optional="show" />
        <field name="time_hours" optional="show" />
        <field name="plates_done" optional="show" />
        <field name="speed" optional="show" />
      </tree>
    </field>
  </record>

  <record id="view_workcenter_productivity_search_ot" model="ir.ui.view">
    <field name="model">mrp.workcenter.productivity</field>
    <field name="arch" type="xml">
      <search string="Work Order Time Tracking">

        <field name="workcenter_id" />
        <field name="calendar_id" />
        <field name="loss_id" />

        <field name="operator_id" />
        <field name="workorder_id" />
        <field name="production_id" />
        <field name="product_id" />
        <field name="procurement_group_id" />
        <field name="date" />

        <group expand="0" string="Group By">
          <filter
            string="Shift (Calendar)"
            name="group_calendar"
            context="{'group_by':'calendar_id'}"
          />
          <filter
            string="Time Type"
            name="group_loss"
            context="{'group_by':'loss_id'}"
          />
          <filter
            string="Operator"
            name="group_operator"
            context="{'group_by':'operator_id'}"
          />
          <filter
            string="Work Center"
            name="group_wc"
            context="{'group_by':'workcenter_id'}"
          />
          <filter
            string="Work Order"
            name="group_wo"
            context="{'group_by':'workorder_id'}"
          />
          <filter
            string="Manufacturing Order"
            name="group_mo"
            context="{'group_by':'production_id'}"
          />
          <filter
            string="Product"
            name="group_product"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Procurement Group"
            name="group_group"
            context="{'group_by':'procurement_group_id'}"
          />
          <filter string="Date" name="group_date" context="{'group_by':'date'}" />
        </group>

      </search>
    </field>
  </record>

  <record id="view_workcenter_productivity_pivot_ot" model="ir.ui.view">
    <field name="model">mrp.workcenter.productivity</field>
    <field name="arch" type="xml">
      <pivot string="Work Order Time Tracking" disable_linking="1">
        <field name="calendar_id" type="row" />
        <field name="loss_id" type="row" />
        <field name="operator_id" type="row" />
        <field name="workcenter_id" type="row" />
        <field name="product_id" type="row" />
        <field name="production_id" type="row" />
        <field name="procurement_group_id" type="row" />
        <field name="date" type="col" />
        <field name="time_hours" type="measure" />
        <field name="plates_done" type="measure" />
        <field name="speed" type="measure" operator="avg" />
      </pivot>
    </field>
  </record>

</odoo>
