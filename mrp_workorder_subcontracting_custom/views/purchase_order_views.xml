<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_purchase_order_form_inherit_subcon" model="ir.ui.view">
    <field name="name">purchase.order.form.inherit.subcon</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form" />
    <field name="arch" type="xml">
        <xpath expr="//field[@name='currency_id']" position="after">
            <field name="subcon_purchase" />
            <field
          name="workorder_id"
          attrs="{'invisible': [('subcon_purchase','=',False)]}"
        />
        </xpath>
    </field>
  </record>
</odoo>
