<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_mrporder" inherit_id="mrp.report_mrporder">
        <t t-call="web.internal_layout" position="attributes">
            <attribute name="t-call">web.external_layout</attribute>
        </t>
        <xpath expr="//span[@t-field='o.product_qty']/.." position="after">
            <div
        t-if="o.lot_producing_id"
        class="col-auto col-3 mw-100 mb-2"
        name="lot-serial-number"
      >
                <strong>Lot/Serial Number:</strong>
                <br />
                <span t-field="o.lot_producing_id.name" />
            </div>
        </xpath>
        <xpath
      expr="//div[@t-if='o.product_description_variants']/.."
      position="attributes"
    >
            <attribute name="class">row mt-4 mb-4</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.product_id']/.." position="attributes">
            <attribute name="class">col-auto col-3 mw-100 mb-2</attribute>
        </xpath>
        <xpath
      expr="//span[@t-field='o.product_description_variants']/.."
      position="attributes"
    >
            <attribute name="class">col-auto col-3 mw-100 mb-2</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.product_qty']/.." position="attributes">
            <attribute name="class">col-auto col-3 mw-100 mb-2</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.qty_producing']/.." position="attributes">
            <attribute name="class">col-auto col-3 mw-100 mb-2</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.qty_producing']/.." position="after">
            <div class="col-auto col-3 mw-100 mb-2" name="date_planned_start">
                <strong>Scheduled Date:</strong>
                <br />
                <span t-field="o.date_planned_start" t-options='{"widget": "date"}' />
            </div>
            <div class="col-auto col-3 mw-100 mb-2" t-if="o.bom_id" name="bom">
                <strong>BoM:</strong>
                <br />
                <span t-field="o.bom_id" />
            </div>
        </xpath>
        <xpath expr="//div[@t-if='o.workorder_ids']//th[2]" position="after">
            <th name="date-start">
                <strong>Date Start</strong>
            </th>
        </xpath>
        <xpath expr="//span[@t-field='line2.workcenter_id.name']/.." position="after">
            <td name="date-start">
                <span
          t-if="line2.date_planned_start"
          t-field="line2.date_planned_start"
        />
            </td>
        </xpath>

        <xpath expr="//table/tr[1]/th[1]" position="before">
            <th width="15%" class="text-center">
                <strong>Sequence</strong>
            </th>
        </xpath>
        <!-- Añadir qr en cada línea -->
        <xpath expr="//table/tr[2]/td[1]" position="before">
            <td width="15%" class="text-center">
                <span t-field="line2.sequence" />
                <t t-set="qr_code" t-value="line2._create_qr_code(line2.sequence)" />
                    <img
          t-att-src="'data:image/png;base64,' + qr_code"
          width="100px"
          height="100px"
        />
            </td>
        </xpath>
        <!-- Añadir QR del nombre -->
        <xpath expr="//span[@t-field='o.name']/../.." position="after">
            <t t-set="qr_code" t-value="o._create_qr_code(o.name)" />
            <img
        t-att-src="'data:image/png;base64,' + qr_code"
        style="height: 100; width: 100px;"
      />
        </xpath>
        <!-- Quitar código de barras -->
        <xpath expr="//div[@t-field='o.name']/.." position="attributes">
          <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template
    id="report_mrp_production_components"
    inherit_id="mrp.report_mrp_production_components"
  >
        <th t-if="o.state in ('progress', 'to_close','done')" position="attributes">
            <attribute name="t-if">False</attribute>
        </th>
        <xpath expr="//tbody//td[2]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <th t-if="has_product_barcode" position="before">
            <th t-if="o.state in ('progress', 'confirmed')">Reserved</th>
            <th t-if="o.state == 'done'">done</th>
        </th>
        <th t-if="has_product_barcode" position="attributes">
            <attribute name="t-if">False</attribute>
        </th>
        <td t-if="has_product_barcode" position="before">
            <td
        t-if="o.state in ('confirmed','progress','to_close')"
        style="text-align: left !important;"
      >
                <span t-field="raw_line.forecast_availability" />
            </td>
            <td t-if="o.state == 'done'" style="text-align: left !important;">
                <span t-field="raw_line.quantity_done" />
                <span t-field="raw_line.product_uom" groups="uom.group_uom" />
            </td>
        </td>
        <td t-if="has_product_barcode" position="attributes">
            <attribute name="t-if">False</attribute>
        </td>

        <span t-field="raw_line.product_id" position="after">
            <table style="margin-left: auto; margin-right: 0; text-align: right;">
                <t t-foreach="raw_line.move_line_ids" t-as="move_line">
                    <tr>
                        <td style="padding: 2px; text-align: right; min-width: 75px;">
                            <t t-if="move_line.lot_id">
                                <span t-field="move_line.lot_id" />
                            </t>
                        </td>
                        <td style="padding: 2px; text-align: right; min-width: 120px;">
                            <t t-if="move_line.location_id">
                                <span t-field="move_line.location_id" />
                            </t>
                        </td>
                        <td style="padding: 2px; text-align: right; min-width: 75px;">
                            <span t-field="move_line.qty_done" />
                        </td>
                    </tr>
                </t>
            </table>
        </span>
    </template>
</odoo>
