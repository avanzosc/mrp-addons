<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_mrp_workorder_block" model="res.groups">
        <field name="name">Allow pressing the "Block" button in Work Orders</field>
        <field
      name="users"
      eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
    />
    </record>

    <record id="group_mrp_workorder_done" model="res.groups">
        <field name="name">Allow pressing the "Done" button in Work Orders</field>
        <field
      name="users"
      eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
    />
    </record>
</odoo>
