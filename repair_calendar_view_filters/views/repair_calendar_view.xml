        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair_calendar_view.repair_calendar_view" />
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="inside">
                <field name="employee_id" filters="1" />
            </xpath>
        </field>
    </record>
</odoo>
