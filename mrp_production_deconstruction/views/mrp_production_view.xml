<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="mrp_production_form_view" model="ir.ui.view">
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="arch" type="xml">
      <field name="company_id" position="after">
        <field name="is_deconstruction" invisible="1" />
      </field>
      <field name="forecast_availability" position="attributes">
        <attribute name="column_invisible">parent.is_deconstruction</attribute>
      </field>
      <page name="components" position="before">
        <page name="move_lines" string="Move Lines">
          <field
            name="move_line_ids"
            context="{'production_id': id, 'default_company_id': company_id}"
            readonly="state in ['draft', 'cancel']"
          >
            <list
              name="mrp_move_lines"
              editable="bottom"
              decoration-muted="state == 'cancel'"
              default_order="location_id"
              limit="300"
            >
              <field name="move_id" invisible="1" />
              <field name="tracking" invisible="1" />
              <field
                name="product_id"
                context="{'default_type': 'product'}"
                required="1"
                readonly="id or state == 'cancel'"
                options="{'no_create': True}"
                force_save="1"
              />
              <field
                name="lot_id"
                groups="stock.group_production_lot"
                readonly="tracking not in ['lot', 'serial']"
                context="{'default_product_id': product_id, 'default_company_id': company_id}"
              />
              <field name="location_id" optional="hide" force_save="1" />
              <field name="location_dest_id" optional="hide" force_save="1" />
              <field
                name="package_id"
                groups="stock.group_tracking_lot"
                optional="hide"
              />
              <field
                name="result_package_id"
                groups="stock.group_tracking_lot"
                optional="hide"
              />
              <field name="product_uom_category_id" invisible="1" />
              <field name="quantity" />
              <field
                name="quantity_product_uom"
                optional="hide"
                readonly="1"
                column_invisible="parent.is_deconstruction"
                sum="Total Reserved"
              />
              <field
                name="product_uom_id"
                optional="hide"
                options="{'no_create': True}"
                groups="uom.group_uom"
                readonly="1"
                force_save="1"
                column_invisible="parent.is_deconstruction"
              />
              <field
                name="company_id"
                invisible="1"
                groups="base.group_multi_company"
                force_save="1"
              />
              <field name="state" optional="hide" />
            </list>
          </field>
        </page>
      </page>
    </field>
  </record>

  <record id="mrp_production_tree_view" model="ir.ui.view">
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
    <field name="arch" type="xml">
      <field name="activity_exception_decoration" position="after">
        <field name="is_deconstruction" optional="hide" />
      </field>
    </field>
  </record>

  <record id="view_mrp_production_filter" model="ir.ui.view">
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
    <field name="arch" type="xml">
      <filter name="todo" position="before">
        <filter
          string="Deconstruction"
          name="is_deconstruction"
          domain="[('is_deconstruction', '=', True)]"
        />
        <separator />
      </filter>
      <filter name="filter_date_start" position="after">
        <filter
          string="Yesterday"
          name="yesterday"
          domain="[('date_start', '&lt;', (context_today()).strftime('%Y-%m-%d')), ('date_start','&gt;', (context_today() - datetime.timedelta(days=2)).strftime('%Y-%m-%d'))]"
        />
        <filter
          string="Today"
          name="today"
          domain="[('date_start', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d')), ('date_start','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"
        />
        <filter
          string="Last Week"
          name="last_week"
          domain="[('date_start','&gt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
        />
        <filter
          string="Last Month"
          name="month"
          domain="[('date_start','&gt;', (context_today() - datetime.timedelta(days=30)).strftime('%%Y-%%m-%%d'))]"
        />
        <filter
          string="Last Year"
          name="year"
          domain="[('date_start','&gt;', (context_today() - datetime.timedelta(days=365)).strftime('%%Y-%%m-%%d'))]"
        />
      </filter>
    </field>
  </record>
</odoo>
