<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="mrp_production_form_view_inherit_move_lines" model="ir.ui.view">
    <field name="name">mrp.production.form.inherit.move.lines</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button
          class="oe_stat_button"
          icon="fa-wrench"
          type="object"
          name="action_view_workorder"
          invisible="workorder_ids == []"
        >
          <field name="workorder_count" string="Work Orders" widget="statinfo" />
        </button>
      </div>

      <xpath expr="//page[@name='components']" position="before">
        <page name="move_lines_tab" string="Move Lines">
          <field
            name="move_line_ids"
            context="{'default_production_id': id, 'default_company_id': company_id}"
            readonly="state in ('draft','cancel')"
          >
            <list
              editable="bottom"
              decoration-muted="state == 'cancel'"
              default_order="id desc"
              limit="300"
            >
              <field
                name="product_id"
                context="{'default_type': 'product'}"
                required="1"
                options="{'no_create': True}"
                readonly="state in ('cancel')"
                force_save="1"
              />
              <field name="lot_id" optional="show" />
              <field name="location_id" optional="hide" />
              <field name="location_dest_id" optional="hide" />
              <field name="product_uom_id" groups="uom.group_uom" />
              <field name="state" optional="hide" />
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

  <record id="view_stock_move_line_tree_mrp" model="ir.ui.view">
    <field name="name">stock.move.line.tree.mrp</field>
    <field name="model">stock.move.line</field>
    <field name="arch" type="xml">
      <list string="Move Lines">
        <field name="production_id" />
        <field name="product_id" />
        <field name="lot_id" />
        <field name="location_id" />
        <field name="location_dest_id" />
        <field name="product_uom_id" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="action_mrp_move_lines" model="ir.actions.act_window">
    <field name="name">Move Lines</field>
    <field name="res_model">stock.move.line</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_stock_move_line_tree_mrp" />
    <field name="domain">[('production_id', '!=', False)]</field>
    <field name="context">{}</field>
  </record>
</odoo>
