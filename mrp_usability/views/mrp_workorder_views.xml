<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp.mrp_workorder_mrp_production_form" model="ir.actions.act_window">
        <field name="target">current</field>
    </record>

    <record id="mrp_production_workorder_form_view_inherit" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
          name="button_start"
          type="object"
          string="Start"
          class="btn-success"
          attrs="{'invisible': ['|', '|', '|', ('production_state','in', ('draft', 'done')), ('working_state', '=', 'blocked'), ('state', '=', 'done'), ('is_user_working', '!=', False)]}"
        />
                <button
          name="button_pending"
          type="object"
          string="Pause"
          class="btn-warning"
          attrs="{'invisible': ['|', '|', ('production_state', 'in', ('draft', 'done')), ('working_state', '=', 'blocked'), ('is_user_working', '=', False)]}"
        />
                <button
          name="button_finish"
          type="object"
          string="Done"
          class="btn-success"
          attrs="{'invisible': ['|', '|', ('production_state', 'in', ('draft', 'done')), ('working_state', '=', 'blocked'), ('is_user_working', '=', False)]}"
        />
                <button
          name="%(mrp.act_mrp_block_workcenter_wo)d"
          type="action"
          string="Block"
          context="{'default_workcenter_id': workcenter_id}"
          class="btn-danger"
          attrs="{'invisible': ['|', ('production_state', 'in', ('draft', 'done')), ('working_state', '=', 'blocked')]}"
        />
                <button
          name="button_unblock"
          type="object"
          string="Unblock"
          context="{'default_workcenter_id': workcenter_id}"
          class="btn-danger"
          attrs="{'invisible': ['|', ('production_state', 'in', ('draft', 'done')), ('working_state', '!=', 'blocked')]}"
        />
            </header>
            <field name="production_id" position="after">
                <field name="workcenter_id" />
            </field>


            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree"
        position="attributes"
      >
                <attribute name="editable">bottom</attribute>
                <attribute name="create">false</attribute>
            </xpath>
            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='product_id']"
        position="after"
      >
                <field name="company_id" invisible="1" />
                <field
          name="location_id"
          readonly="1"
          force_save="1"
          groups="stock.group_stock_multi_locations"
          optional="show"
        />
                <field
          name="product_uom_qty"
          widget="mrp_should_consume"
          force_save="1"
          string="To Consume"
          width="1"
        />
                <field
          name="product_uom"
          options="{'no_open': True, 'no_create': True}"
          groups="uom.group_uom"
        />
                <field name="forecast_availability" string="Reserved" />
            </xpath>
            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='quantity_done']"
        position="after"
      >
                <field
          name="lot_ids"
          widget="many2many_tags"
          optional="hide"
          readonly="1"
          string="Lot/Serial Numbers"
          help="Displays the consumed Lot/Serial Numbers."
          groups="stock.group_production_lot"
          options="'no_create': True"
          context="{'default_company_id': company_id, 'default_product_id': product_id}"
          domain="[('product_id','=',product_id)]"
        />
            </xpath>
            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='product_qty_available']"
        position="attributes"
      >
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='product_qty']"
        position="attributes"
      >
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='product_virtual_available']"
        position="attributes"
      >
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='reserved_availability']"
        position="attributes"
      >
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_work_order_search" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_work_order_search" />
        <field name="arch" type="xml">
            <field name="production_id" position="after">
                <field name="product_id" />
            </field>
        </field>
    </record>

    <record id="iew_mrp_production_workorder_form_view_filter" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field
      name="inherit_id"
      ref="mrp.view_mrp_production_workorder_form_view_filter"
    />
        <field name="arch" type="xml">
            <field name="production_id" position="after">
                <field name="product_id" />
            </field>
        </field>
    </record>

    <record id="mrp_workorder_view_tree" model="ir.ui.view">
        <field name="model">mrp.workorder</field>
        <field
      name="inherit_id"
      ref="mrp.mrp_production_workorder_tree_editable_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_produced']" position="attributes">
                <attribute name="attrs">{'optional_show': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_remaining']" position="after">
                <field name="qty_producing" optional="show" />
                <field name="qty_production" optional="show" />
                <field name="qty_reported_from_previous_wo" optional="show" />
            </xpath>
        </field>
    </record>


</odoo>
