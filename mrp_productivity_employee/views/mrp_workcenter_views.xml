<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_workcenter_view" model="ir.ui.view">
    <field name="model">mrp.workcenter</field>
    <field name="inherit_id" ref="mrp.mrp_workcenter_view" />
    <field name="arch" type="xml">
      <page name="capacity" position="after">
        <page string="Employees" name="employees">
          <field name="employee_ids">
            <list string="Employees" js_class="hr_employee_list">
              <field name="name" />
              <field name="department_id" />
              <field name="job_id" />
            </list>
          </field>
        </page>
      </page>
    </field>
  </record>

  <record id="mrp_workcenter_tree_view" model="ir.ui.view">
    <field name="model">mrp.workcenter</field>
    <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view" />
    <field name="arch" type="xml">
      <field name="alternative_workcenter_ids" position="after">
        <field name="employee_ids" widget="many2many_tags" optional="show" />
      </field>
    </field>
  </record>
</odoo>
