<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_department_tree" model="ir.ui.view">
    <field name="model">hr.department</field>
    <field name="inherit_id" ref="hr.view_department_tree" />
    <field name="arch" type="xml">
      <field name="total_employee" position="after">
        <field name="production_department" optional="show" />
      </field>
    </field>
  </record>

  <record id="view_department_form" model="ir.ui.view">
    <field name="model">hr.department</field>
    <field name="inherit_id" ref="hr.view_department_form" />
    <field name="arch" type="xml">
      <field name="parent_id" position="after">
        <field name="production_department" />
      </field>
    </field>
  </record>

  <record id="view_department_filter" model="ir.ui.view">
    <field name="model">hr.department</field>
    <field name="inherit_id" ref="hr.view_department_filter" />
    <field name="arch" type="xml">
      <filter name="message_needaction" position="before">
        <separator />
        <filter
          string="It is a Production Depart."
          name="is-production-depart"
          domain="[('production_department','=',True)]"
        />
        <filter
          string="It is not a Production Depart."
          name="not-production-depart"
          domain="[('production_department','=',False)]"
        />
        <separator />
      </filter>
    </field>
  </record>
</odoo>
