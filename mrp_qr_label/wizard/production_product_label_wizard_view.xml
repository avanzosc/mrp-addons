<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="production_product_label_wizard_view" model="ir.ui.view">
        <field name="model">production.product.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Printing Product Labels">
                <sheet>
                    <group colspan="4">
                        <field name="mrp_production_id" options="{'no_open' : True}" />
                        <field name="product_id" options="{'no_open' : True}" />
                        <field name="remaining_quantity" />
                        <field name="allowed_lot_ids" invisible="1" />
                    </group>
                    <div>
                        <field
              name="production_product_label_line_ids"
              nolabel="1"
              col="4"
            >
                            <tree editable="top">
                                <field name="wizard_id" invisible="1" />
                                <field
                  name="lot_id"
                  widget="selection"
                  domain="[('id', 'in', parent.allowed_lot_ids)]"
                />
                                <field name="product_qty" />
                            </tree>
                        </field>
                    </div>
                    <group colspan="4">
                        <field name="bin" col="4" />
                    </group>
                </sheet>

                <footer>
                    <button
            string="Print label(s)"
            name="print_product_label"
            type="object"
            class="oe_highlight"
          />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_production_product_label_wizard" model="ir.actions.act_window">
        <field name="name">Print Product Labels</field>
        <field name="res_model">production.product.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="view_id" ref="production_product_label_wizard_view" />
    </record>
</odoo>
