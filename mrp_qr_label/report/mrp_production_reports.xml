<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="mrp_production_product_qr_label_document">
        <t t-call="stock_product_qr_label.external_layout_quant_product_label">
            <div
        class="page"
        style="font-size: 16px !important; font-family: ubuntu condensed; page-break-after: always; padding-top: 5px;  margin-right: -10px; margin-left: -10px; margin-bottom: -10px; margin-top: 10px;"
      >
                <div class="row">
                    <div class="col-6">
                        <b><span
                t-field="doc.product_id.default_code"
                style="text-align: left;"
              /></b>
                    </div>
                    <div class="col-6" style="text-align: right;">
                        <b><span
                t-field="doc.create_date"
                t-options="{&quot;widget&quot;: &quot;date&quot;}"
              /></b>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                      <b><span t-esc="doc.product_id.name_for_labels" /></b>
                    </div>
                </div>
                <div class="row">
                        <div class="col-8" style="padding-right: 30px;">
                        <b>
                            <span>Lot.: </span>
                            <span t-field="doc.lot_id.name" />
                            <br />
                            <span>Bin: </span>
                            <span t-field="doc.lot_id.ref" />
                        </b>
                    </div>
                    <div class="col-4">
                        <t
              t-set="qr_code"
              t-value="'%s %s' % (doc.product_id.code, doc.lot_id.name)"
            />
                        <img
              t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', qr_code, 70, 70)"
              style="margin-left: 10px;"
            />
                    </div>
                </div>
            </div>
        </t>

    </template>

    <template id="report_mrp_production_product_qr_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="production">
                <t t-foreach="production.move_finished_ids" t-as="move">
                    <t t-foreach="move.move_line_ids" t-as="doc">
                        <t
              t-call="mrp_qr_label.mrp_production_product_qr_label_document"
              t-lang="doc.company_id.partner_id.lang"
            />
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record
    id="action_mrp_production_product_qr_label_report"
    model="ir.actions.report"
  >
        <field name="name">Product QR Label</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field
      name="report_name"
    >mrp_qr_label.report_mrp_production_product_qr_label</field>
        <field
      name="report_file"
    >mrp_qr_label.report_mrp_production_product_qr_label</field>
        <field
      name="print_report_name"
    >('QR Label - %s' % (object.product_id.name))</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="binding_type">report</field>
        <field
      name="paperformat_id"
      ref="stock_product_qr_label.paperformat_product_qr_label"
    />
    </record>
</odoo>
