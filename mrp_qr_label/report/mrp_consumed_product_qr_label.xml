<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_mrp_consumed_product_qr_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="production">
                <t t-foreach="production.move_raw_ids" t-as="doc">
                    <t t-set="consumed" t-value="True" />
                    <t
            t-call="mrp_qr_label.mrp_product_to_consume_qr_label_document"
            t-lang="doc.company_id.partner_id.lang"
          />
                </t>
            </t>
        </t>
    </template>

    <record id="action_mrp_consumed_product_qr_label_report" model="ir.actions.report">
        <field name="name">Consumed Products QR Label</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field
      name="report_name"
    >mrp_qr_label.report_mrp_consumed_product_qr_label</field>
        <field
      name="report_file"
    >mrp_qr_label.report_mrp_consumed_product_qr_label</field>
        <field
      name="print_report_name"
    >('QR Label Consumed Products For Product - %s' % (object.product_id.name))</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="binding_type">report</field>
        <field
      name="paperformat_id"
      ref="stock_product_qr_label.paperformat_product_qr_label"
    />
    </record>
</odoo>
