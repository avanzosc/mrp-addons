<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_production_view_form" model="ir.ui.view">
    <field name="name">mrp.production.form.sale.custom.values</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="arch" type="xml">
      <field name="product_description_variants" position="after">
        <field
          name="sale_custom_description"
          widget="html"
          readonly="1"
          invisible="not sale_custom_description"
        />
      </field>
      <field name="product_description_variants" position="attributes">
        <attribute name="invisible">
                    not product_description_variants or sale_custom_description
                </attribute>
      </field>
      <xpath
        expr="//field[@name='move_raw_ids']/list/field[@name='product_id']"
        position="attributes"
      >
        <attribute name="widget">mrp_component_product_many2one</attribute>
      </xpath>
      <xpath
        expr="//field[@name='move_raw_ids']/list/field[@name='product_id']"
        position="after"
      >
        <field name="graphic_custom_description" column_invisible="True" />
      </xpath>
    </field>
  </record>
</odoo>
