<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_bom_version_tree_view" model="ir.ui.view">
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp_bom_version.mrp_bom_version_tree_view" />
        <field name="arch" type="xml">
             <field name="historical_date" position="after">
                 <field name="first_creation_date" optional="show" />
             </field>
        </field>
    </record>

    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
             <field name="code" position="after">
                 <field name="first_creation_date" readonly="1" />
             </field>
        </field>
    </record>
</odoo>
