<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_bom_import_view_tree" model="ir.ui.view">
    <field name="model">mrp.bom.import</field>
    <field name="arch" type="xml">
      <list
        decoration-danger="state=='error'"
        decoration-muted="state=='done'"
        decoration-bf="state=='pass'"
      >
        <field name="name" />
        <field name="file_date" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="mrp_bom_import_view_form" model="ir.ui.view">
    <field name="model">mrp.bom.import</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_import_file"
            string="Import"
            type="object"
            invisible="state == 'done'"
          />
          <button
            name="action_validate"
            string="Validate"
            type="object"
            invisible="state not in ('2validate', 'error')"
          />
          <button
            name="action_process"
            string="Process"
            type="object"
            invisible="state not in ('pass', '2validate', 'error')"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              string="Import Lines"
              type="object"
              name="button_open_import_line"
              class="oe_stat_button"
              icon="fa-bars"
            />
            <button
              string="BoM Lists"
              type="object"
              name="button_open_boms"
              class="oe_stat_button"
              icon="fa-flask"
              invisible="bom_count == 0"
            >
              <field name="bom_count" widget="statinfo" />
            </button>
            <button
              string="BoM Components"
              type="object"
              name="button_open_bom_lines"
              class="oe_stat_button"
              icon="fa-flask"
              invisible="bom_line_count == 0"
            >
              <field name="bom_line_count" widget="statinfo" />
            </button>
          </div>
          <group>
            <group>
              <field name="filename" invisible="1" readonly="state == 'done'" />
              <field name="data" filename="filename" readonly="state == 'done'" />
              <field name="file_date" readonly="state == 'done'" />
            </group>
            <group>
              <field name="product_found_by_code" readonly="state == 'done'" />
            </group>
          </group>
          <notebook>
            <page string="Lines">
              <field name="import_line_ids" readonly="state == 'done'" />
            </page>
            <page string="Log" invisible="log_info == ''">
              <field name="log_info" />
            </page>
            <page string="Help" name="help_page">
              <div style="margin-top: 4px;">
                <h3>Help with Excel column names</h3>
                <p>You must use this column names in order to fill the table:</p>
                <ul name="tutorial">
                  <li><code>Product Code</code>: this will fill <b
                  >Component Product Code</b></li>
                  <li><code>Product Name</code>: this will fill <b
                  >Component Product Name</b></li>
                  <li><code>Quantity</code>: this will fill <b
                  >Component Quantity</b></li>
                  <li><code>Parent Code</code>: this will fill <b
                  >Parent Product Code</b></li>
                  <li><code>Parent Name</code>: this will fill <b
                  >Parent Product Name</b></li>
                  <li><code>Parent Qty</code>: this will fill <b
                  >Parent Product Quantity</b></li>
                  <li><code>BoM Ref</code>: this will fill <b>BoM Reference</b></li>
                </ul>
              </div>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="mrp_bom_import_act" model="ir.actions.act_window">
    <field name="name">MRP BoM Import</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">mrp.bom.import</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="mrp_bom_import_view_tree" />
  </record>

  <menuitem
    id="menu_bom_import"
    name="BoM Import"
    parent="mrp.menu_mrp_configuration"
    groups="mrp.group_mrp_manager"
    sequence="120"
  />

  <menuitem
    id="mrp_bom_import"
    parent="menu_bom_import"
    action="mrp_bom_import_act"
    sequence="10"
  />
</odoo>
