<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group/group" position="inside">
                <field name="pallet_id" />
                <field name="packaging_id" />
            </xpath>
            <xpath
        expr="//field[@name='byproduct_ids']/tree/field[@name='product_uom_id']"
        position="after"
      >
                <field name="coefficient" />
                <field name="expense_kg" />
                <field name="cost" />
            </xpath>
            <xpath
        expr="//form/sheet/notebook/page[@name='components']/field[@name='bom_line_ids']/tree/field[@name='product_qty']"
        position="after"
      >
                <field
          name="coefficient"
          optional="show"
          attrs="{'column_invisible': [('parent.is_deconstruction', '=', False)]}"
        />
                <field
          name="expense_kg"
          optional="show"
          attrs="{'column_invisible': [('parent.is_deconstruction', '=', False)]}"
        />
                <field name="currency_id" invisible="1" />
                <field
          name="cost"
          optional="show"
          widget='monetary'
          options="{'currency_field': 'currency_id'}"
          attrs="{'column_invisible': [('parent.is_deconstruction', '=', False)]}"
        />
            </xpath>
        </field>
    </record>
</odoo>
